# Local editor and assistant configuration — personal, and specific to one
# machine. It should never have been in a public repository.
.claude/
.vscode/
.idea/

# Python
__pycache__/
*.pyc

# Written by tools/watch.py; regenerated on every run.
drafts/

# Working files kept beside the site but never part of it. The repository is
# public and every tracked file is served from the web root, so a stray commit
# of these would publish them. Source material and hand-over artefacts.
CV_long.docx
rodem-site-update.patch
rodem-webpage-updated.zip

# Photograph originals straight off a phone, 4–6 MB each. The web-sized copies
# in images/events/ and images/team/ are what the site serves; see
# images/events/README.md for how they are made.
/images/*.jpg
/images/*.jpeg
/images/*.png
/images/team/Boninchi_*
/images/team/Group_picture.*
/images/team/*_original.*

# macOS
.DS_Store
